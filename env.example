# 后端服务环境变量配置文件
# 可以通过修改这些值来调整JVM参数和连接数配置
# 复制此文件为 .env 并修改相应的值

# ========================================
# JVM参数配置
# ========================================

# 完整的JVM参数（优先级最高）
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# 堆内存配置
JAVA_HEAP_INITIAL=256m
JAVA_HEAP_MAX=512m

# GC配置
JAVA_GC_TYPE=-XX:+UseG1GC
JAVA_GC_PAUSE=-XX:MaxGCPauseMillis=200

# ========================================
# Tomcat连接池配置
# ========================================

# 线程池配置
SERVER_TOMCAT_THREADS_MAX=200
SERVER_TOMCAT_THREADS_MIN_SPARE=20
SERVER_TOMCAT_MAX_CONNECTIONS=8192
SERVER_TOMCAT_ACCEPT_COUNT=100
SERVER_TOMCAT_CONNECTION_TIMEOUT=20000

# ========================================
# 数据库连接池配置
# ========================================

# HikariCP连接池配置
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# ========================================
# 应用配置
# ========================================

# Spring配置
SPRING_PROFILES_ACTIVE=docker

# 日志级别
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_API=DEBUG

# ========================================
# 性能调优建议
# ========================================

# 小内存环境（1-2GB）
# JAVA_HEAP_INITIAL=128m
# JAVA_HEAP_MAX=256m
# SERVER_TOMCAT_THREADS_MAX=100
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# 中等内存环境（2-4GB）
# JAVA_HEAP_INITIAL=256m
# JAVA_HEAP_MAX=512m
# SERVER_TOMCAT_THREADS_MAX=200
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20

# 大内存环境（4GB+）
# JAVA_HEAP_INITIAL=512m
# JAVA_HEAP_MAX=1g
# SERVER_TOMCAT_THREADS_MAX=400
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=50
