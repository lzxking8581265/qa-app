# 分布式部署环境变量配置文件
# 复制此文件为 .env 并根据实际部署环境修改

# ==================== 数据库配置 ====================
# MySQL数据库主机地址（可以是IP地址或域名）
MYSQL_HOST=192.168.1.100
# MySQL端口
MYSQL_PORT=3306
# MySQL数据库名
MYSQL_DATABASE=api_recorder
# MySQL root密码
MYSQL_ROOT_PASSWORD=first@YD
# MySQL应用用户
MYSQL_USER=api_user
# MySQL应用密码
MYSQL_PASSWORD=api_pass

# ==================== 后端服务配置 ====================
# 后端服务端口
BACKEND_PORT=8080
# 后端服务主机地址（用于前端连接）
BACKEND_HOST=192.168.1.101
# 数据库连接URL（支持远程数据库）
SPRING_DATASOURCE_URL=jdbc:mysql://192.168.1.100:3306/api_recorder?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# 数据库用户名
SPRING_DATASOURCE_USERNAME=root
# 数据库密码
SPRING_DATASOURCE_PASSWORD=first@YD
# JPA配置
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
# Spring Profile
SPRING_PROFILES_ACTIVE=docker

# JVM参数配置
JAVA_OPTS=-Xmx1g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=100 -XX:+UseStringDeduplication -XX:+OptimizeStringConcat
JAVA_HEAP_INITIAL=256m
JAVA_HEAP_MAX=512m
JAVA_GC_TYPE=-XX:+UseG1GC
JAVA_GC_PAUSE=-XX:MaxGCPauseMillis=200

# Tomcat连接池配置
SERVER_TOMCAT_THREADS_MAX=400
SERVER_TOMCAT_THREADS_MIN_SPARE=50
SERVER_TOMCAT_MAX_CONNECTIONS=16384
SERVER_TOMCAT_ACCEPT_COUNT=200
SERVER_TOMCAT_CONNECTION_TIMEOUT=30000

# HikariCP连接池配置
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=50
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=10
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# 日志级别配置
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_API=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_HIBERNATE=WARN
LOGGING_LEVEL_COM_ZAXXER_HIKARI=INFO

# 性能监控配置
APP_PERFORMANCE_MONITORING_ENABLED=true
APP_PERFORMANCE_SLOW_QUERY_THRESHOLD=100
APP_PERFORMANCE_LOG_SLOW_QUERIES=true
APP_PERFORMANCE_LOG_METRICS=true

# 跨域配置
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# DGuard配置
DGUARD_VOLUME_PATH=/root/yd/qa_app/dguard/

# ==================== 前端服务配置 ====================
# 前端服务端口
FRONTEND_PORT=3000
# 前端服务主机地址
FRONTEND_HOST=192.168.1.102
# 后端API基础URL
REACT_APP_API_BASE_URL=http://192.168.1.101:8080
# API超时时间
REACT_APP_API_TIMEOUT=30000
# 前端标题
REACT_APP_TITLE=API Recorder
# 前端版本
REACT_APP_VERSION=1.0.0

# ==================== 网络配置 ====================
# 是否使用外部网络（true表示各服务独立部署）
USE_EXTERNAL_NETWORK=true
# 数据库网络名称
MYSQL_NETWORK_NAME=mysql-external
# 后端网络名称
BACKEND_NETWORK_NAME=backend-external
# 前端网络名称
FRONTEND_NETWORK_NAME=frontend-external

# ==================== 安全配置 ====================
# 是否启用SSL/TLS
ENABLE_SSL=false
# SSL证书路径
SSL_CERT_PATH=/etc/ssl/certs/api-recorder.crt
# SSL私钥路径
SSL_KEY_PATH=/etc/ssl/private/api-recorder.key

# ==================== 监控配置 ====================
# 是否启用健康检查
ENABLE_HEALTHCHECK=true
# 健康检查间隔
HEALTHCHECK_INTERVAL=30s
# 健康检查超时
HEALTHCHECK_TIMEOUT=10s
# 健康检查重试次数
HEALTHCHECK_RETRIES=3
# 健康检查启动等待时间
HEALTHCHECK_START_PERIOD=60s
